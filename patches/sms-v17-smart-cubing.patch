diff --git a/src/cubing.cpp b/src/cubing.cpp
index 2bd9c7d..ea73b79 100644
--- a/src/cubing.cpp
+++ b/src/cubing.cpp
@@ -548,14 +548,29 @@ void printGame(const vector<vector<int>> &cubeTrail)
 
 int GraphSolver::countAssignedOrInactive(const vector<vector<int>> &cubeTrail)
 {
+    if (config.lookaheadOnlyEdgeVars)
+    {
+        // cubeTrail[0] contains root propagation.  A reusable cube must be
+        // cut on assignments made *after* that root state; otherwise a
+        // strongly constrained graph formula reaches the cutoff before the
+        // first decision and the cuber emits the empty cube.
+        const int edgeVariables = graphHandler->getNumVariables();
+        std::set<int> assignedAfterRoot;
+        for (size_t level = 1; level < cubeTrail.size(); level++)
+            for (auto lit : cubeTrail[level])
+                if (abs(lit) <= edgeVariables)
+                    assignedAfterRoot.insert(abs(lit));
+        return assignedAfterRoot.size();
+    }
+
     int count = 0;
     for (auto lits : cubeTrail)
         for (auto lit : lits)
         {
             if (active(abs(lit)))
                 count++;
         }
 
     count += vars() - active(); // inactive variables
     return count;
 }
